# ==========================================
# Waste Disposal Assistant - Environment Config
# ==========================================

# Database Configuration
DATABASE_URL="sqlite:///./waste_management.db"

# JWT Authentication
JWT_SECRET_KEY="replace_with_a_secure_random_jwt_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Upload Settings (5 MB in bytes)
MAX_UPLOAD_SIZE=5242880

# AI / ML Classifier Settings
AI_CONFIDENCE_THRESHOLD=0.60

# Frontend & CORS Configuration
FRONTEND_URL="http://localhost:3000"
VITE_API_URL="http://127.0.0.1:8000"
