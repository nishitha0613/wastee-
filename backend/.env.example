# ==========================================
# Waste Disposal Assistant - Environment Config
# ==========================================

# Application Metadata
PROJECT_NAME="Smart Waste Management API"
VERSION="0.1.0"
API_V1_STR="/api"

# Database Configuration
DATABASE_URL="sqlite:///./waste_management.db"

# JWT Authentication
# IMPORTANT: Generate a secure random 32+ character key for production (e.g., openssl rand -hex 32)
JWT_SECRET_KEY="replace_with_a_secure_random_jwt_secret_in_production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Frontend & CORS Configuration
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173"

# File Upload Settings
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE=5242880

# AI / ML Classifier Settings
AI_CONFIDENCE_THRESHOLD=0.60
AI_MODEL_PATH="app/models_ml/waste_classifier.onnx"
IMAGE_INPUT_SIZE=224

# Initial Admin Seed Credentials (used by python -m app.seed_admin)
ADMIN_NAME="System Administrator"
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="gulugulu"
